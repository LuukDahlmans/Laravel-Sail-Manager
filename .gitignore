.env
.env.*
!.env.example

# Editor / IDE config (personal, not for the public repo)
.vscode/
.idea/
.fleet/
.zed/
.cursor/

# Editor backup / swap files
*.swp
*.swo
*.bak
*~

# Local-only architecture / development notes (not for the public repo)
CLAUDE.md

# Local build outputs (Tauri bundles end up under src-tauri/target/, but in
# case anyone drops a built DMG / .app at the repo root, ignore those too)
*.dmg
*.app
