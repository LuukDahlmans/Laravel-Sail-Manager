---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const SITE_URL = 'https://sailmanager.app';

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function readingTime(body: string | undefined): string {
  if (!body) return '1 min';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} min`;
}

// Article JSON-LD for rich-result eligibility on Google.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://github.com/LuukDahlmans',
  },
  keywords: post.data.keywords.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}`, SITE_URL).toString(),
  },
};

// Find adjacent posts for previous/next nav.
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const idx = all.findIndex((p) => p.id === post.id);
const prevPost = idx > 0 ? all[idx - 1] : null;
const nextPost = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
---

<Layout title={post.data.title} description={post.data.description}>
  <Nav />

  <Fragment slot="head">
    <meta name="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.keywords.length > 0 && (
      <meta name="keywords" content={post.data.keywords.join(', ')} />
    )}
  </Fragment>

  <main id="main" class="blog-post-page">
    <article class="post">
      <div class="container post-container">
        <header class="post-header">
          <a class="back-link" href="/blog">
            <span aria-hidden="true">←</span> All posts
          </a>
          <div class="meta">
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span class="dot">·</span>
            <span>{readingTime(post.body)} read</span>
            {post.data.tags.length > 0 && (
              <>
                <span class="dot">·</span>
                <span class="tags">{post.data.tags.slice(0, 3).join(', ')}</span>
              </>
            )}
          </div>
          <h1>{post.data.title}</h1>
          <p class="post-lede">{post.data.description}</p>
        </header>

        <div class="post-body">
          <Content />
        </div>

        <footer class="post-footer">
          <div class="byline">
            Written by <strong>{post.data.author}</strong>.
            Found a mistake? <a href="https://github.com/LuukDahlmans/Laravel-Sail-Manager/issues" target="_blank" rel="noopener">Open an issue</a>.
          </div>

          {(prevPost || nextPost) && (
            <nav class="post-nav" aria-label="More posts">
              {prevPost ? (
                <a class="post-nav-link prev" href={`/blog/${prevPost.id}`}>
                  <span class="dir">← Newer post</span>
                  <span class="link-title">{prevPost.data.title}</span>
                </a>
              ) : <span></span>}
              {nextPost ? (
                <a class="post-nav-link next" href={`/blog/${nextPost.id}`}>
                  <span class="dir">Older post →</span>
                  <span class="link-title">{nextPost.data.title}</span>
                </a>
              ) : <span></span>}
            </nav>
          )}
        </footer>
      </div>
    </article>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</Layout>

<style>
  .blog-post-page {
    padding: 2.5rem 0 4rem;
  }
  .post-container { max-width: 760px; }

  .post-header { margin-bottom: 2rem; }
  .back-link {
    display: inline-block;
    color: var(--text-dim);
    font-size: 12.5px;
    margin-bottom: 1.5rem;
    transition: color 0.15s var(--ease-quick);
  }
  .back-link:hover { color: var(--accent); }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-faint);
    margin-bottom: 0.85rem;
  }
  .meta .dot { color: var(--text-faint); }
  .meta .tags { color: var(--accent); }

  .post-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .post-lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-dim);
    margin-bottom: 0;
  }

  .post-body {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text);
  }
  .post-body :global(h2) {
    font-size: 1.55rem;
    letter-spacing: -0.02em;
    margin: 2.5rem 0 0.75rem;
    color: var(--text);
    scroll-margin-top: 90px;
  }
  .post-body :global(h3) {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
    color: var(--text);
    scroll-margin-top: 90px;
  }
  .post-body :global(p) {
    margin-bottom: 1.1rem;
    color: var(--text);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0.75rem 0 1.25rem;
    padding-left: 1.4rem;
    color: var(--text);
  }
  .post-body :global(li) {
    margin: 0.4rem 0;
    line-height: 1.7;
  }
  .post-body :global(li strong) {
    color: var(--text);
    font-weight: 650;
  }
  .post-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
    transition: border-color 0.15s var(--ease-quick), color 0.15s var(--ease-quick);
  }
  .post-body :global(a:hover) {
    border-bottom-color: var(--accent);
  }
  .post-body :global(code) {
    font-size: 0.88em;
    color: #ffb6ad;
    background: rgba(255, 58, 46, 0.08);
    border: 1px solid rgba(255, 58, 46, 0.18);
    padding: 0.1em 0.45em;
    border-radius: 4px;
  }
  .post-body :global(pre) {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }
  .post-body :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--code-text);
    font-size: 13px;
  }
  .post-body :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.5rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-2);
    border-radius: 0 8px 8px 0;
    color: var(--text-dim);
    font-style: italic;
  }
  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 13.5px;
  }
  .post-body :global(th) {
    text-align: left;
    background: var(--bg-2);
    padding: 8px 12px;
    border: 1px solid var(--border);
    font-weight: 650;
    font-size: 12.5px;
    color: var(--text);
  }
  .post-body :global(td) {
    padding: 8px 12px;
    border: 1px solid var(--border);
    color: var(--text-dim);
  }
  .post-body :global(hr) {
    margin: 2rem 0;
    border: 0;
    height: 1px;
    background: var(--border);
  }
  .post-body :global(strong) { color: var(--text); font-weight: 650; }

  /* Inline pill badge used inside H2/H3 to mark the recommended option in
     any "approach 1 / approach 2 / approach 3" ranking. Authors add it via
     <span class="recommended"> in the markdown body. */
  .post-body :global(.recommended) {
    display: inline-block;
    margin-left: 10px;
    padding: 3px 9px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    border-radius: 999px;
    vertical-align: middle;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    box-shadow: 0 0 0 1px rgba(255, 58, 46, 0.05);
  }
  .post-body :global(h2 .recommended),
  .post-body :global(h3 .recommended) {
    /* The h2/h3 baseline is a couple px above small caps height. */
    transform: translateY(-2px);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .byline {
    color: var(--text-faint);
    font-size: 12.5px;
    margin-bottom: 1.5rem;
  }
  .byline strong { color: var(--text-dim); font-weight: 650; }
  .byline a { color: var(--accent); }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    text-decoration: none;
    transition: background 0.15s var(--ease-quick), border-color 0.15s var(--ease-quick), transform 0.15s var(--ease-quick);
  }
  .post-nav-link:hover {
    background: var(--bg-3);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .post-nav-link.next { text-align: right; align-items: flex-end; }
  .post-nav-link .dir {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    font-weight: 600;
  }
  .post-nav-link .link-title {
    color: var(--text);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  @media (max-width: 600px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-link.next { text-align: left; align-items: flex-start; }
  }
</style>
