---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Estimated read time helper. Same 200 wpm convention as Medium / dev.to.
function readingTime(body: string | undefined): string {
  if (!body) return '1 min';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} min`;
}
---

<Layout
  title="Blog"
  description="Articles on Laravel Sail, running multiple Sail projects, adding services, .test domains, Horizon, queues, and the differences between Sail, Valet, and Herd."
>
  <Nav />
  <main id="main" class="blog-page">
    <section class="hero-section">
      <div class="container">
        <span class="eyebrow">Blog</span>
        <h1>Notes on Laravel Sail, Docker, and local dev.</h1>
        <p class="lede">
          Practical writing on the things that come up when you actually run Laravel projects
          locally. No filler, no SEO sludge.
        </p>
      </div>
    </section>

    <section class="posts">
      <div class="container">
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="post-card">
                <div class="post-meta">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)}
                  </time>
                  <span class="dot">·</span>
                  <span>{readingTime(post.body)} read</span>
                  {post.data.tags.length > 0 && (
                    <>
                      <span class="dot">·</span>
                      <span class="tags">{post.data.tags.slice(0, 2).join(', ')}</span>
                    </>
                  )}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="read-more" aria-hidden="true">
                  Read post →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-page { padding-bottom: 4rem; }

  .hero-section {
    padding: 3.5rem 0 2.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .hero-section h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0.85rem;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-section .lede {
    font-size: 1rem;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto;
  }

  .posts { padding: 3rem 0 0; }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-card {
    display: block;
    padding: 22px 26px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-dim);
    text-decoration: none;
    transition:
      background 0.18s var(--ease-quick),
      border-color 0.18s var(--ease-quick),
      transform 0.18s var(--ease-quick);
  }
  .post-card:hover {
    background: var(--bg-3);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  .post-meta .dot { color: var(--text-faint); }
  .post-meta .tags { color: var(--accent); }

  .post-card h2 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
    color: var(--text);
  }
  .post-card:hover h2 { color: var(--accent); transition: color 0.18s var(--ease-quick); }
  .post-card p {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    color: var(--text-dim);
  }
  .read-more {
    display: inline-block;
    font-size: 12.5px;
    color: var(--accent);
    margin-top: 0.85rem;
    font-weight: 600;
    transition: transform 0.15s var(--ease-quick);
  }
  .post-card:hover .read-more { transform: translateX(2px); }

  @media (max-width: 600px) {
    .post-card { padding: 18px 20px; }
    .post-card h2 { font-size: 1.2rem; }
  }
</style>
