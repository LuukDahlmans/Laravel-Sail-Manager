---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DemoIntro from '../components/DemoIntro.astro';
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import Workflow from '../components/Workflow.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Run multiple Laravel Sail projects in parallel"
  description="A free, open-source macOS app for running every Laravel Sail project at the same time. Per-project ports, real .test URLs, auto-migrate on start, native menu bar."
>
  <Nav />
  <main id="main">
    <Hero />

    <section id="demo" class="demo-section" aria-labelledby="demo-title">
      <div class="container">
        <DemoIntro />
        <div class="reveal demo-wrap">
          <Demo />
        </div>
      </div>
    </section>

    <hr class="divider" />
    <Features />
    <hr class="divider" />
    <Workflow />
    <Download />
    <Faq />
  </main>
  <Footer />
</Layout>

<style>
  .demo-section { padding: 1.5rem 0 4.5rem; }
  .demo-wrap { transition-duration: 0.9s; }
</style>
