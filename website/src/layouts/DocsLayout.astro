---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { docGroups, allPages, findAdjacent } from '../lib/docs';

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
const { prev, next } = findAdjacent(slug);

// Pre-serialize the search index. Generated server-side at build time so the
// client doesn't need to fetch a separate JSON file — keeps the docs working
// even if a CDN strips trailing slashes etc.
const searchIndex = allPages.map((p) => ({
  slug: p.slug,
  title: p.title,
  description: p.description,
  sections: p.sections,
}));
---

<Layout title={`${title} · Docs`} description={description}>
  <Nav />
  <main id="main" class="docs-page">
    <div class="container docs-layout">
      <aside class="sidebar" aria-label="Documentation navigation">
        <div class="sidebar-inner">
          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              type="search"
              id="docs-search"
              placeholder="Search docs"
              autocomplete="off"
              aria-label="Search documentation"
            />
            <kbd class="kbd-hint" aria-hidden="true">⌘K</kbd>
          </div>

          <div class="search-results" id="docs-search-results" role="listbox" aria-label="Search results"></div>

          <nav class="docs-nav" id="docs-nav">
            {docGroups.map((group) => (
              <div class="nav-group">
                <h4>{group.title}</h4>
                <ul>
                  {group.pages.map((page) => (
                    <li>
                      <a
                        href={`/docs/${page.slug}`}
                        class:list={['nav-link', { active: page.slug === slug }]}
                        aria-current={page.slug === slug ? 'page' : undefined}
                      >
                        {page.title}
                      </a>
                      {page.slug === slug && page.sections.length > 0 && (
                        <ul class="sub-list">
                          {page.sections.map((section) => (
                            <li>
                              <a href={`#${section.id}`} class="sub-link">{section.label}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <article class="docs-content">
        <header class="docs-page-head">
          <span class="eyebrow">Docs</span>
          <h1>{title}</h1>
          <p>{description}</p>
        </header>

        <hr class="divider" />

        <slot />

        <nav class="page-nav" aria-label="Documentation pagination">
          {prev ? (
            <a class="page-nav-link prev" href={`/docs/${prev.slug}`}>
              <span class="dir">← Previous</span>
              <span class="link-title">{prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="page-nav-link next" href={`/docs/${next.slug}`}>
              <span class="dir">Next →</span>
              <span class="link-title">{next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script type="application/json" id="docs-search-data" set:html={JSON.stringify(searchIndex)}></script>

<script is:inline>
  // Tiny client-side search. Matches against page titles, descriptions, and
  // section labels. No external lib — just a substring match with a couple
  // of relevance signals (title hits beat description hits, exact prefix
  // beats anywhere-in-string).
  (function () {
    const dataEl = document.getElementById('docs-search-data');
    const input = document.getElementById('docs-search');
    const results = document.getElementById('docs-search-results');
    const nav = document.getElementById('docs-nav');
    if (!dataEl || !input || !results || !nav) return;

    let pages = [];
    try {
      pages = JSON.parse(dataEl.textContent || '[]');
    } catch (_) {
      pages = [];
    }

    function score(text, query) {
      if (!text) return 0;
      const t = text.toLowerCase();
      const idx = t.indexOf(query);
      if (idx < 0) return 0;
      // Earlier matches and word-boundary matches rank higher.
      let s = 100 - idx;
      if (idx === 0 || /\s/.test(t.charAt(idx - 1))) s += 30;
      return s;
    }

    function search(rawQuery) {
      const q = rawQuery.trim().toLowerCase();
      if (q.length < 2) return [];

      const hits = [];
      for (const page of pages) {
        const titleScore = score(page.title, q) * 3;
        const descScore = score(page.description, q);
        if (titleScore || descScore) {
          hits.push({
            type: 'page',
            page,
            section: null,
            score: titleScore + descScore,
          });
        }
        for (const section of page.sections) {
          const sectionScore = score(section.label, q) * 2;
          if (sectionScore) {
            hits.push({
              type: 'section',
              page,
              section,
              score: sectionScore,
            });
          }
        }
      }

      hits.sort((a, b) => b.score - a.score);
      return hits.slice(0, 8);
    }

    function highlight(text, query) {
      if (!query) return text;
      const i = text.toLowerCase().indexOf(query.toLowerCase());
      if (i < 0) return text;
      const end = i + query.length;
      return text.slice(0, i) + '<mark>' + text.slice(i, end) + '</mark>' + text.slice(end);
    }

    function render(hits, query) {
      if (!query || query.trim().length < 2) {
        results.innerHTML = '';
        results.classList.remove('open');
        nav.classList.remove('hidden');
        return;
      }
      nav.classList.add('hidden');
      results.classList.add('open');
      if (hits.length === 0) {
        results.innerHTML = '<p class="search-empty">No matches for <strong>' + escapeHtml(query) + '</strong>.</p>';
        return;
      }
      const html = hits.map((hit) => {
        const href = hit.section
          ? '/docs/' + hit.page.slug + '#' + hit.section.id
          : '/docs/' + hit.page.slug;
        const primary = hit.section ? hit.section.label : hit.page.title;
        const secondary = hit.section ? hit.page.title : hit.page.description;
        return (
          '<a class="search-hit" href="' + href + '" role="option">' +
          '<span class="hit-primary">' + highlight(escapeHtml(primary), query) + '</span>' +
          '<span class="hit-secondary">' + escapeHtml(secondary) + '</span>' +
          '</a>'
        );
      }).join('');
      results.innerHTML = html;
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    let lastValue = '';
    input.addEventListener('input', () => {
      const v = input.value;
      if (v === lastValue) return;
      lastValue = v;
      render(search(v), v);
    });

    // Cmd/Ctrl + K focuses the search.
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
      }
      if (e.key === 'Escape' && document.activeElement === input) {
        input.value = '';
        lastValue = '';
        render([], '');
        input.blur();
      }
    });

    // Clicking a result navigates and clears so the user lands on a clean nav.
    results.addEventListener('click', (e) => {
      const t = e.target;
      if (t && t.closest && t.closest('.search-hit')) {
        // Clear after navigation. The browser's anchor scroll happens first.
        setTimeout(() => {
          input.value = '';
          lastValue = '';
          render([], '');
        }, 50);
      }
    });
  })();
</script>

<style>
  .docs-page {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  .docs-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 3rem;
    align-items: flex-start;
  }

  /* ============== Sidebar ============== */
  .sidebar {
    position: sticky;
    top: 76px;
    align-self: flex-start;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
  .sidebar-inner { padding-right: 1rem; }

  /* Search input */
  .search-wrap {
    position: relative;
    margin-bottom: 1.25rem;
  }
  .search-wrap input {
    width: 100%;
    padding: 8px 56px 8px 32px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s var(--ease-quick), background 0.15s var(--ease-quick);
  }
  .search-wrap input::placeholder { color: var(--text-faint); }
  .search-wrap input:focus {
    border-color: var(--accent);
    background: var(--bg-3);
  }
  .search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-faint);
    pointer-events: none;
  }
  .kbd-hint {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    font-family: ui-monospace, 'SF Mono', monospace;
    font-size: 10px;
    color: var(--text-faint);
    pointer-events: none;
  }
  .search-wrap input:focus ~ .kbd-hint { display: none; }

  /* Search results */
  .search-results {
    display: none;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 1rem;
  }
  .search-results.open { display: flex; }
  .search-hit {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 12px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    text-decoration: none;
    transition: background 0.15s var(--ease-quick), border-color 0.15s var(--ease-quick);
  }
  .search-hit:hover {
    background: var(--bg-3);
    border-color: var(--accent-soft);
  }
  .hit-primary {
    color: var(--text);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.3;
  }
  .hit-primary :global(mark) {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0 2px;
    border-radius: 2px;
  }
  .hit-secondary {
    color: var(--text-faint);
    font-size: 11px;
    line-height: 1.4;
  }
  .search-empty {
    margin: 0;
    padding: 12px;
    background: var(--bg-2);
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
    color: var(--text-faint);
    font-size: 12px;
    text-align: center;
  }
  .search-empty strong { color: var(--text-dim); font-weight: 600; }

  .docs-nav.hidden { display: none; }

  /* Nav groups */
  .nav-group { margin-bottom: 1.25rem; }
  .nav-group h4 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    display: block;
    padding: 6px 10px;
    border-radius: 5px;
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.4;
    transition: background 0.15s var(--ease-quick), color 0.15s var(--ease-quick);
  }
  .nav-link:hover { color: var(--text); background: var(--bg-2); }
  .nav-link.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .sub-list {
    list-style: none;
    padding: 0;
    margin: 4px 0 8px;
    border-left: 1px solid var(--border);
    margin-left: 16px;
  }
  .sub-link {
    display: block;
    padding: 4px 12px;
    margin-left: -1px;
    font-size: 12px;
    color: var(--text-dim);
    border-left: 1px solid transparent;
    line-height: 1.4;
    transition: color 0.15s var(--ease-quick), border-color 0.15s var(--ease-quick);
  }
  .sub-link:hover { color: var(--text); }
  .sub-link.active,
  .sub-link[aria-current="true"] {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* ============== Content ============== */
  .docs-content {
    min-width: 0;
    max-width: 760px;
  }
  .docs-page-head {
    margin-bottom: 1.25rem;
  }
  .docs-page-head h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0.85rem;
  }
  .docs-page-head p {
    font-size: 14.5px;
    line-height: 1.65;
    max-width: 620px;
  }

  /* Shared content styling — used by every page that wraps in DocsLayout. */
  :global(.docs-content section) {
    padding: 1.5rem 0 0;
  }
  :global(.docs-content h2) {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    margin-top: 1.5rem;
    margin-bottom: 0.85rem;
    scroll-margin-top: 90px;
  }
  :global(.docs-content section:first-of-type h2) { margin-top: 0; }
  :global(.docs-content h3) {
    font-size: 1rem;
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--text);
    scroll-margin-top: 90px;
  }
  :global(.docs-content p) {
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 0.85rem;
    color: var(--text-dim);
  }
  :global(.docs-content p strong),
  :global(.docs-content li strong) {
    color: var(--text);
    font-weight: 650;
  }
  :global(.docs-content .bullets),
  :global(.docs-content .steps) {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0.85rem;
  }
  :global(.docs-content .bullets li),
  :global(.docs-content .steps li) {
    position: relative;
    padding-left: 22px;
    margin: 0.4rem 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text-dim);
  }
  :global(.docs-content .bullets li::before) {
    content: '';
    position: absolute;
    left: 6px;
    top: 11px;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }
  :global(.docs-content .steps) { counter-reset: step; }
  :global(.docs-content .steps li) {
    counter-increment: step;
    padding-left: 30px;
  }
  :global(.docs-content .steps li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10.5px;
    font-weight: 700;
    font-family: ui-monospace, 'SF Mono', monospace;
  }
  :global(.docs-content code) {
    font-size: 12.5px;
    color: #ffb6ad;
    background: rgba(255, 58, 46, 0.08);
    border-color: rgba(255, 58, 46, 0.18);
  }
  :global(.docs-content pre) {
    margin: 1rem 0 1.25rem;
    font-size: 12.5px;
  }
  :global(.docs-content pre code) {
    color: var(--code-text);
    background: transparent;
    border: 0;
  }
  :global(.docs-content .note) {
    margin: 0.75rem 0 1rem;
    padding: 12px 16px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
  }
  :global(.docs-content .service-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin: 1rem 0;
  }
  :global(.docs-content .service-cat) {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
  }
  :global(.docs-content .service-cat h4) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  :global(.docs-content .service-cat .bullets li) {
    padding-left: 16px;
    font-size: 13px;
  }
  :global(.docs-content .service-cat .bullets li::before) {
    left: 4px;
    top: 9px;
    width: 4px;
    height: 4px;
  }

  /* Page-to-page nav */
  .page-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .page-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    text-decoration: none;
    transition: background 0.15s var(--ease-quick), border-color 0.15s var(--ease-quick), transform 0.15s var(--ease-quick);
  }
  .page-nav-link:hover {
    background: var(--bg-3);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .page-nav-link.next { text-align: right; align-items: flex-end; }
  .page-nav-link .dir {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    font-weight: 600;
  }
  .page-nav-link .link-title {
    color: var(--text);
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  /* Mobile: stack and detach the sidebar from sticky positioning. */
  @media (max-width: 920px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }
    .sidebar-inner { padding-right: 0; }
    .sub-list { display: none; }
  }
</style>
