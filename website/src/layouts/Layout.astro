---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const SITE_NAME = 'Sail Manager';
const SITE_URL = 'https://sailmanager.app';
const DEFAULT_DESCRIPTION =
  'A free, open-source macOS app for running every Laravel Sail project at the same time. Per-project ports, real .test URLs, native menu bar, no /etc/hosts edits.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Run every Laravel Sail project at once`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const absoluteOgImage = new URL(ogImage, SITE_URL).toString();

// JSON-LD: SoftwareApplication schema gives Google rich-snippet data and helps
// the page rank for "laravel sail mac app" / "docker laravel desktop" queries.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  operatingSystem: 'macOS',
  applicationCategory: 'DeveloperApplication',
  description: DEFAULT_DESCRIPTION,
  url: SITE_URL,
  downloadUrl: 'https://github.com/LuukDahlmans/Laravel-Sail-Manager/releases',
  softwareVersion: '0.1.0',
  license: 'https://opensource.org/licenses/MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Luuk Dahlmans',
    url: 'https://github.com/LuukDahlmans',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#0a0e14" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta name="keywords" content="laravel sail, laravel docker, laravel mac app, multiple sail projects, sail port conflict, laravel parallel development, laravel valet alternative, sail manager, docker laravel desktop" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script is:inline>
      // Hero / above-the-fold elements get marked .reveal-now on first paint
      // so they animate in on load instead of waiting for IntersectionObserver
      // (which would briefly leave them invisible). Everything else uses the
      // observer below.
      (function () {
        const hero = document.querySelector('.hero');
        if (hero) {
          hero.querySelectorAll('.reveal').forEach((el) => {
            el.classList.add('reveal-now');
            el.classList.remove('reveal');
          });
        }

        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
