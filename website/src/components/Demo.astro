---
import Logo from './Logo.astro';

// All projects start idle. The demo's vanilla JS handles state transitions,
// resource-bar animation, and the "running count" in the sidebar header.
const projects = [
  {
    id: 'shop',
    name: 'shop',
    url: 'shop.test',
    services: 'mysql · redis · mailpit',
    branch: 'main',
    ports: '8081 · 33061 · 63791',
  },
  {
    id: 'api',
    name: 'api',
    url: 'api.test',
    services: 'pgsql · redis · meilisearch',
    branch: 'feature/search',
    dirty: true,
    ports: '8082 · 54322 · 63792',
  },
  {
    id: 'admin',
    name: 'admin',
    url: 'admin.test',
    services: 'mysql · redis · horizon',
    branch: 'main',
    ports: '8083 · 33063 · 63793',
  },
  {
    id: 'marketing',
    name: 'marketing-site',
    url: 'marketing.test',
    services: 'mysql · mailpit',
    branch: 'main',
    ports: '8084 · 33064',
  },
];
---

<div class="app-shell" role="img" aria-label="Sail Manager interactive demo">
  <div class="window-chrome">
    <span class="dot red"></span>
    <span class="dot amber"></span>
    <span class="dot green"></span>
    <span class="window-title">Sail Manager</span>
  </div>

  <div class="app-body">
    <aside class="sidebar">
      <div class="brand">
        <Logo size={34} />
        <div class="brand-text">
          <div class="brand-name">Sail Manager</div>
          <div class="brand-sub" data-running-count>0 running</div>
        </div>
      </div>

      <nav class="side-nav">
        <a class="nav-item active" data-tab="projects" href="#demo">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10" />
          </svg>
          <span>Projects</span>
        </a>
        <a class="nav-item" data-tab="templates" href="#demo">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" />
          </svg>
          <span>Templates</span>
        </a>
        <a class="nav-item" data-tab="settings" href="#demo">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
          <span>Settings</span>
        </a>
      </nav>

      <div class="spacer"></div>

      <div class="side-footer">
        <div class="docker-status">
          <span class="docker-dot"></span>
          <span>Docker running</span>
        </div>
        <div class="sys-stats">
          <div class="sys-row">
            <span class="sys-label">CPU</span>
            <div class="sys-track"><div class="sys-fill" data-sys-cpu style="width: 12%"></div></div>
            <span class="sys-val" data-sys-cpu-val>12%</span>
          </div>
          <div class="sys-row">
            <span class="sys-label">RAM</span>
            <div class="sys-track"><div class="sys-fill" data-sys-ram style="width: 18%"></div></div>
            <span class="sys-val" data-sys-ram-val>1.2 GB</span>
          </div>
          <div class="sys-row">
            <span class="sys-label">Disk</span>
            <span class="sys-spacer"></span>
            <span class="sys-val">8.4 GB</span>
          </div>
        </div>
      </div>
    </aside>

    <main class="main-pane">
      <header class="pane-header">
        <div>
          <h3>Projects</h3>
          <p class="pane-sub" data-projects-summary>4 projects · 0 running</p>
        </div>
        <div class="pane-actions">
          <button class="btn" type="button" data-action="start-all">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg>
            Start all
          </button>
          <button class="btn" type="button" data-action="stop-all">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M6 6h12v12H6z"/></svg>
            Stop all
          </button>
        </div>
      </header>

      <div class="rows">
        {projects.map((p) => (
          <div class="row" data-row data-id={p.id} data-status="idle" tabindex="0" role="button">
            <div class="indicator">
              <span class="status-dot"></span>
              <span class="ring"></span>
            </div>
            <div class="row-main">
              <div class="row-title">
                <span class="proj-name">{p.name}</span>
                <span class="status-text">Idle</span>
              </div>
              <div class="row-secondary">
                <span class="row-url">{p.url}</span>
                <span class="row-sep">·</span>
                <span class="row-meta">{p.services}</span>
                <span class="row-sep">·</span>
                <span class={`row-branch${p.dirty ? ' dirty' : ''}`}>
                  {p.branch}
                  {p.dirty && <span class="dirty-mark">●</span>}
                </span>
              </div>
              <div class="resource-bars" aria-hidden="true">
                <div class="rb">
                  <span class="rb-label">CPU</span>
                  <div class="rb-track"><div class="rb-fill" data-cpu style="width: 0%"></div></div>
                  <span class="rb-value" data-cpu-val>0%</span>
                </div>
                <div class="rb">
                  <span class="rb-label">RAM</span>
                  <div class="rb-track"><div class="rb-fill" data-ram style="width: 0%"></div></div>
                  <span class="rb-value" data-ram-val>0 MB</span>
                </div>
              </div>
            </div>
            <div class="row-actions">
              <button class="btn primary-action" type="button" data-action="toggle">
                <span class="action-content">
                  <svg class="play-icon" viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg>
                  <svg class="stop-icon" viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M6 6h12v12H6z"/></svg>
                  <span class="spinner" aria-hidden="true"></span>
                  <span class="action-label">Start</span>
                </span>
              </button>
              <button class="btn icon-btn" type="button" data-action="open" disabled aria-label="Open in browser">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M21 3l-9 9M5 5h7v2H7v10h10v-5h2v7H5z"/></svg>
              </button>
            </div>
          </div>
        ))}
      </div>

    </main>
  </div>
</div>

<script>
  // Tiny state machine that mirrors the real app's start/stop flow:
  // idle → starting (1.4s) → running, with the indicator ring + resource bars
  // animating in. Stop reverses it.
  type Status = 'idle' | 'starting' | 'running' | 'stopping';

  function init() {
    const shell = document.querySelector<HTMLElement>('.app-shell');
    if (!shell) return;
    const rows = shell.querySelectorAll<HTMLElement>('[data-row]');
    const runningCount = shell.querySelector<HTMLElement>('[data-running-count]');
    const summary = shell.querySelector<HTMLElement>('[data-projects-summary]');
    const sysCpu = shell.querySelector<HTMLElement>('[data-sys-cpu]');
    const sysCpuVal = shell.querySelector<HTMLElement>('[data-sys-cpu-val]');
    const sysRam = shell.querySelector<HTMLElement>('[data-sys-ram]');
    const sysRamVal = shell.querySelector<HTMLElement>('[data-sys-ram-val]');

    const statsTimers = new WeakMap<HTMLElement, number>();

    function setStatus(row: HTMLElement, status: Status) {
      row.dataset.status = status;
      const label = row.querySelector<HTMLElement>('.action-label');
      const statusText = row.querySelector<HTMLElement>('.status-text');
      const openBtn = row.querySelector<HTMLButtonElement>('[data-action="open"]');
      const toggleBtn = row.querySelector<HTMLButtonElement>('[data-action="toggle"]');

      if (statusText) {
        statusText.textContent =
          status === 'running' ? 'Running' :
          status === 'starting' ? 'Starting' :
          status === 'stopping' ? 'Stopping' : 'Idle';
      }
      if (label) {
        label.textContent =
          status === 'running' ? 'Stop' :
          status === 'starting' ? 'Starting' :
          status === 'stopping' ? 'Stopping' : 'Start';
      }
      if (openBtn) openBtn.disabled = status !== 'running';
      if (toggleBtn) toggleBtn.disabled = status === 'starting' || status === 'stopping';

      if (status === 'running') tickStats(row);
      else stopStats(row);
      refreshSummary();
    }

    function tickStats(row: HTMLElement) {
      stopStats(row);
      const cpuFill = row.querySelector<HTMLElement>('[data-cpu]');
      const cpuVal = row.querySelector<HTMLElement>('[data-cpu-val]');
      const ramFill = row.querySelector<HTMLElement>('[data-ram]');
      const ramVal = row.querySelector<HTMLElement>('[data-ram-val]');
      const baseCpu = 8 + Math.random() * 12;
      const baseRam = 180 + Math.random() * 100;

      const update = () => {
        const cpu = Math.max(1, Math.min(95, baseCpu + (Math.random() - 0.5) * 14));
        const ram = baseRam + (Math.random() - 0.4) * 60;
        if (cpuFill) {
          cpuFill.style.width = `${cpu}%`;
          cpuFill.classList.toggle('rb-warn', cpu > 70);
          cpuFill.classList.toggle('rb-hot', cpu > 90);
        }
        if (cpuVal) cpuVal.textContent = `${cpu.toFixed(0)}%`;
        if (ramFill) ramFill.style.width = `${Math.min(100, (ram / 512) * 100)}%`;
        if (ramVal) ramVal.textContent = `${ram.toFixed(0)} MB`;
      };
      update();
      const id = window.setInterval(update, 1600);
      statsTimers.set(row, id);
    }

    function stopStats(row: HTMLElement) {
      const id = statsTimers.get(row);
      if (id) {
        window.clearInterval(id);
        statsTimers.delete(row);
      }
      const cpuFill = row.querySelector<HTMLElement>('[data-cpu]');
      const cpuVal = row.querySelector<HTMLElement>('[data-cpu-val]');
      const ramFill = row.querySelector<HTMLElement>('[data-ram]');
      const ramVal = row.querySelector<HTMLElement>('[data-ram-val]');
      if (cpuFill) cpuFill.style.width = '0%';
      if (cpuVal) cpuVal.textContent = '0%';
      if (ramFill) ramFill.style.width = '0%';
      if (ramVal) ramVal.textContent = '0 MB';
    }

    function refreshSummary() {
      const total = rows.length;
      const running = Array.from(rows).filter((r) => r.dataset.status === 'running').length;
      if (runningCount) runningCount.textContent = `${running} running`;
      if (summary) summary.textContent = `${total} projects · ${running} running`;

      // Drive the sidebar daemon stats from the running count for a believable
      // "more projects = more load" feedback loop.
      const baseCpu = 4 + running * 9 + Math.random() * 4;
      const baseRam = 0.6 + running * 0.7;
      if (sysCpu) sysCpu.style.width = `${Math.min(100, baseCpu)}%`;
      if (sysCpuVal) sysCpuVal.textContent = `${baseCpu.toFixed(0)}%`;
      if (sysRam) sysRam.style.width = `${Math.min(100, (baseRam / 8) * 100)}%`;
      if (sysRamVal) sysRamVal.textContent = `${baseRam.toFixed(1)} GB`;
    }

    function toggle(row: HTMLElement) {
      const current = (row.dataset.status as Status) ?? 'idle';
      if (current === 'idle') {
        setStatus(row, 'starting');
        window.setTimeout(() => setStatus(row, 'running'), 1400);
      } else if (current === 'running') {
        setStatus(row, 'stopping');
        window.setTimeout(() => setStatus(row, 'idle'), 900);
      }
    }

    rows.forEach((row) => {
      const toggleBtn = row.querySelector<HTMLButtonElement>('[data-action="toggle"]');
      if (toggleBtn) toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle(row);
      });
    });

    shell.querySelector('[data-action="start-all"]')?.addEventListener('click', () => {
      rows.forEach((r, i) => {
        if (r.dataset.status === 'idle') window.setTimeout(() => toggle(r), i * 220);
      });
    });
    shell.querySelector('[data-action="stop-all"]')?.addEventListener('click', () => {
      rows.forEach((r, i) => {
        if (r.dataset.status === 'running') window.setTimeout(() => toggle(r), i * 180);
      });
    });

    refreshSummary();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .app-shell {
    background: var(--bg-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    max-width: 1080px;
    margin: 0 auto;
    font-size: 13px;
    line-height: 1.5;
  }

  .window-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .window-chrome .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .window-chrome .dot.red { background: #ff5f56; }
  .window-chrome .dot.amber { background: #ffbd2e; }
  .window-chrome .dot.green { background: #27c93f; }
  .window-title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--text-faint);
    pointer-events: none;
    font-weight: 500;
  }

  .app-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 540px;
    background: var(--bg);
  }

  /* Sidebar — recreated from src/lib/components/Sidebar.svelte */
  .sidebar {
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    padding: 16px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    overflow: hidden;
  }
  .sidebar::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--grid-fade), radial-gradient(60% 40% at 12% 8%, var(--accent-soft) 0%, transparent 60%);
    opacity: 0.55;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px 10px;
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 1;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-size: 13.5px; font-weight: 650; letter-spacing: -0.01em; color: var(--text); }
  .brand-sub { font-size: 11px; color: var(--text-dim); margin-top: 1px; }

  .side-nav { display: flex; flex-direction: column; gap: 2px; position: relative; z-index: 1; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 12.5px;
    font-weight: 500;
    transition: background 0.15s var(--ease-quick), color 0.15s var(--ease-quick);
    position: relative;
  }
  .nav-item:hover { background: var(--bg-3); color: var(--text); }
  .nav-item.active {
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-soft) inset;
  }
  .nav-item.active::before {
    content: '';
    position: absolute;
    left: -12px; top: 8px; bottom: 8px;
    width: 3px;
    background: var(--accent);
    border-radius: 0 3px 3px 0;
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .spacer { flex: 1; }

  .side-footer {
    padding: 10px 6px 4px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .docker-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--success);
  }
  .docker-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px var(--success-soft);
  }
  .sys-stats { display: flex; flex-direction: column; gap: 7px; padding: 4px; }
  .sys-row { display: grid; grid-template-columns: 28px 1fr auto; align-items: center; gap: 8px; }
  .sys-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    text-transform: uppercase;
  }
  .sys-track { height: 4px; background: var(--bg-3); border-radius: 999px; overflow: hidden; }
  .sys-spacer { height: 4px; }
  .sys-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--success) 0%, color-mix(in oklab, var(--success), white 18%) 100%);
    box-shadow: 0 0 6px var(--success-glow);
    border-radius: 999px;
    transition: width 0.5s var(--ease);
  }
  .sys-val {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 44px;
  }

  /* Main pane */
  .main-pane {
    padding: 18px 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pane-header h3 {
    font-size: 18px;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pane-sub {
    font-size: 11.5px;
    color: var(--text-dim);
    margin-top: 2px;
  }
  .pane-actions { display: flex; gap: 6px; }
  .pane-actions .btn { padding: 6px 11px; font-size: 12px; }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Row — recreated from src/lib/components/ProjectCard.svelte */
  .row {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: background 0.15s var(--ease-quick), border-color 0.15s var(--ease-quick);
    text-align: left;
    cursor: pointer;
  }
  .row:hover { background: var(--bg-3); border-color: var(--border-strong); }
  .row:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  .indicator {
    width: 26px; height: 26px;
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .status-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--text-faint);
    z-index: 1;
    transition: background 0.15s var(--ease-quick);
  }
  .row[data-status='running'] .status-dot { background: var(--success); }
  .row[data-status='starting'] .status-dot,
  .row[data-status='stopping'] .status-dot {
    background: var(--warning);
    animation: pulse 1.2s ease-in-out infinite;
  }
  .ring {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1.5px solid var(--success);
    opacity: 0;
    pointer-events: none;
  }
  .row[data-status='running'] .ring {
    opacity: 0.55;
    animation: ring-expand 2.4s ease-out infinite;
  }

  .row-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .row-title { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .proj-name {
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .status-text {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .row[data-status='running'] .status-text { color: var(--success); }
  .row[data-status='starting'] .status-text,
  .row[data-status='stopping'] .status-text { color: var(--warning); }

  .row-secondary {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: 11.5px;
    min-width: 0;
    overflow: hidden;
  }
  .row-sep { color: var(--text-faint); }
  .row-url {
    color: var(--text-dim);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 11.5px;
  }
  .row-meta { text-transform: lowercase; }
  .row-branch {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 11px;
  }
  .row-branch.dirty { color: var(--warning); }
  .dirty-mark { font-size: 10px; }

  .resource-bars {
    display: none;
    gap: 12px;
    margin-top: 5px;
  }
  .row[data-status='running'] .resource-bars { display: flex; }
  .rb { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; }
  .rb-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-faint);
