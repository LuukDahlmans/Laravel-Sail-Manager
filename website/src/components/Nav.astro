---
import Logo from './Logo.astro';
const GITHUB_URL = 'https://github.com/LuukDahlmans/Laravel-Sail-Manager';
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Sail Manager home">
      <Logo size={28} />
      <span>Sail Manager</span>
    </a>
    <nav class="links" aria-label="Primary">
      <a href="/#demo">Demo</a>
      <a href="/#features">Features</a>
      <a href="/docs">Docs</a>
      <a href="/blog">Blog</a>
      <a href={GITHUB_URL} rel="noopener" target="_blank" class="gh">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
        </svg>
        GitHub
      </a>
      <a class="btn btn-primary btn-sheen nav-cta" href="/#download">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
        </svg>
        Download
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 12, 14, 0.78);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 650;
    color: var(--text);
    font-size: 14px;
    letter-spacing: -0.015em;
  }
  .brand:hover { color: var(--text); }

  .links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .links a:not(.btn):not(.gh) {
    color: var(--text-dim);
    font-size: 13px;
    font-weight: 500;
  }
  .links a:not(.btn):not(.gh):hover { color: var(--text); }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-dim);
    font-size: 13px;
    font-weight: 500;
  }
  .gh:hover { color: var(--text); }

  .nav-cta {
    padding: 6px 13px;
    font-size: 12.5px;
  }

  @media (max-width: 720px) {
    .links a:not(.nav-cta) { display: none; }
  }
</style>
