---
const GITHUB_RELEASES = 'https://github.com/LuukDahlmans/Laravel-Sail-Manager/releases';
const GITHUB_URL = 'https://github.com/LuukDahlmans/Laravel-Sail-Manager';
const VERSION = '0.1.0';
---

<section id="download" aria-labelledby="download-title">
  <div class="container">
    <div class="panel reveal">
      <div class="panel-bg" aria-hidden="true">
        <div class="grid-bg"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
      </div>

      <div class="panel-content">
        <span class="eyebrow">Get it</span>
        <h2 id="download-title">
          Install once. Run <span class="grad">every project</span>.
        </h2>
        <p class="lede">
          Free, open source, and yours forever. Works on Apple Silicon and
          Intel Macs. You'll need Docker Desktop installed and running.
        </p>

        <div class="cta-row">
          <a class="btn btn-primary btn-lg btn-sheen download-btn" href={GITHUB_RELEASES} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            Download
          </a>
          <a class="btn btn-ghost btn-lg" href={GITHUB_URL} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
              <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
            </svg>
            Source on GitHub
          </a>
        </div>

        <div class="meta-row">
          <span class="meta-chip">
            <span class="meta-dot"></span>
            Latest <strong>v{VERSION}</strong>
          </span>
          <span class="meta-chip">Universal binary</span>
          <span class="meta-chip">Apple Silicon &amp; Intel</span>
        </div>

        <details class="build">
          <summary>Or build it yourself</summary>
          <pre><code>git clone https://github.com/LuukDahlmans/Laravel-Sail-Manager.git
cd Laravel-Sail-Manager
npm install
npm run tauri build</code></pre>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 4.5rem 2rem 3.25rem;
    text-align: center;
    overflow: hidden;
    background: var(--bg-1);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 32px 80px -20px rgba(0, 0, 0, 0.5);
  }

  h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }
  .grad {
    background: linear-gradient(135deg, var(--accent) 0%, #ff8a52 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    background-size: 200% 200%;
    animation: shimmer 6s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* Layered background: subtle dotted grid + two soft red orbs that drift. */
  .panel-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.045) 1px, transparent 0);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 35%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 35%, black 30%, transparent 75%);
  }
  /* Orbs sit BEHIND the panel rim only, never under the text. The orb itself
     is heavily blurred and offset off-canvas so just the soft tail reaches in
     toward the corner. Plus a vignette layer below the text keeps reading
     contrast high regardless. */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    animation: drift 14s ease-in-out infinite;
  }
  .orb-1 {
    width: 280px;
    height: 280px;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    opacity: 0.32;
  }
  .orb-2 {
    width: 220px;
    height: 220px;
    bottom: -150px;
    right: -80px;
    background: #ff8a52;
    opacity: 0.18;
    animation-delay: -6s;
  }
  @keyframes drift {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, -10px); }
  }
  .orb-2 { animation-name: drift-r; }
  @keyframes drift-r {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-10px, -10px); }
  }

  /* Vignette: dark wash directly under the text column so the orb glow can't
     reduce contrast on the heading. */
  .panel-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 50% 60% at 50% 55%,
      var(--bg-1) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .panel-content {
    position: relative;
    z-index: 1;
  }

  .lede {
    max-width: 460px;
    margin: 0.5rem auto 0;
    font-size: 14.5px;
    line-height: 1.6;
  }

  .cta-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .download-btn {
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 600;
  }
  .download-btn:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 6px 20px var(--accent-glow),
      0 1px 0 rgba(0, 0, 0, 0.12);
  }

  .meta-row {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }
  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--text-dim);
    padding: 4px 10px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .meta-chip strong {
    color: var(--text);
    font-weight: 650;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 11px;
  }
  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px var(--success-soft);
    animation: blip 2s ease-in-out infinite;
  }
  @keyframes blip {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.5; }
  }

  .build {
    margin-top: 2.5rem;
    text-align: left;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .build summary {
    cursor: pointer;
    color: var(--text-faint);
    font-size: 12px;
    text-align: center;
    list-style: none;
    user-select: none;
    transition: color 0.15s var(--ease-quick);
    padding: 6px 12px;
    display: inline-block;
    margin: 0 auto;
    width: 100%;
  }
  .build summary::-webkit-details-marker { display: none; }
  .build summary:hover { color: var(--text); }
  .build summary::after {
    content: ' ↓';
    color: var(--accent);
    transition: transform 0.2s ease;
    display: inline-block;
  }
  .build[open] summary::after { content: ' ↑'; }
  .build pre {
    margin-top: 1rem;
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .orb,
    .grad,
    .meta-dot {
      animation: none !important;
    }
  }

  @media (max-width: 600px) {
    .panel { padding: 3rem 1.25rem 2rem; }
  }
</style>
