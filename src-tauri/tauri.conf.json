{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sail Manager",
  "version": "0.1.0",
  "identifier": "com.laraveldevtool.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sail Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 800, "height": 500 },
        "windowPosition": { "x": 200, "y": 200 },
        "appPosition": { "x": 200, "y": 350 },
        "applicationFolderPosition": { "x": 600, "y": 350 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LuukDahlmans/Laravel-Sail-Manager/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_YOUR_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
